{
    "product": {
        "name": "AI Image Description and Alt Text Authoring Tool",
        "version": "1.0",
        "supported_domains": [
            "publishing",
            "medical",
            "education",
            "nursing"
        ]
    },
    "global_inputs": {
        "image_context": {
            "image_purpose": [
                "decorative",
                "illustrative",
                "instructional",
                "assessment"
            ],
            "placement": [
                "chapter_opener",
                "inline",
                "captioned",
                "standalone"
            ],
            "action_required": {
                "type": "boolean",
                "description": "Indicates whether user interaction or action is required"
            }
        },
        "audience": {
            "education_level": [
                "elementary",
                "middle_school",
                "high_school",
                "college_professional",
                "general_public"
            ],
            "subject_familiarity": [
                "introductory",
                "intermediate",
                "advanced"
            ]
        },
        "image_type": [
            "photograph",
            "illustration_painting",
            "diagram",
            "graph",
            "map",
            "table",
            "text_only_image",
            "mathematics"
        ],
        "metadata": {
            "title": {
                "type": "string",
                "optional": true
            },
            "caption": {
                "type": "string",
                "optional": true
            },
            "embedded_text": {
                "type": "string",
                "optional": true
            },
            "labels_legends": {
                "type": "string",
                "optional": true
            },
            "axis_labels_units": {
                "type": "string",
                "optional": true
            }
        }
    },
    "domain_rules": {
        "publishing": {
            "tone": "editorial_neutral",
            "description_depth": "concise_by_default",
            "constraints": {
                "allow_interpretation": false,
                "repeat_caption_content": false,
                "emotive_language": false
            },
            "output_preferences": {
                "default_format": [
                    "short_alt_text",
                    "optional_long_description"
                ]
            }
        },
        "medical": {
            "tone": "clinical_objective",
            "description_depth": "detailed_structural",
            "constraints": {
                "diagnostic_language": false,
                "treatment_advice": false,
                "speculation": false,
                "person_first_language": true,
                "emotive_language": false
            },
            "required_elements": {
                "anatomy_images": [
                    "orientation",
                    "view_type",
                    "labels_exact"
                ],
                "data_visuals": [
                    "units",
                    "measurement_scales"
                ]
            },
            "output_preferences": {
                "default_format": [
                    "structured_long_description"
                ],
                "review_flag": true
            }
        },
        "education": {
            "tone": "instructional_neutral",
            "description_depth": "grade_aligned",
            "constraints": {
                "introduce_new_concepts": false,
                "assessment_answer_cues": false
            },
            "pedagogical_controls": {
                "align_with_grade_level": true,
                "focus_on_learning_objective": true
            },
            "output_preferences": {
                "default_format": [
                    "narrative",
                    "bulleted_lists",
                    "tables"
                ]
            }
        },
        "nursing": {
            "tone": "clinical_instructional",
            "description_depth": "procedural_structured",
            "constraints": {
                "clinical_decision_making": false,
                "dosage_implication": false,
                "outcome_prediction": false
            },
            "required_elements": {
                "procedure_images": [
                    "patient_position",
                    "clinician_position",
                    "equipment_names",
                    "sequence_indicators"
                ]
            },
            "output_preferences": {
                "default_format": [
                    "step_oriented_structured_description"
                ],
                "review_flag": true
            }
        }
    },
    "language_and_style_rules": {
        "tense": "present",
        "voice": "active",
        "objectivity_required": true,
        "color_usage": "only_if_meaningful",
        "abbreviations": "spell_out_for_screen_readers",
        "numbers": "spell_out_when_needed_for_audio_clarity"
    },
    "output_types": {
        "supported_outputs": [
            "decorative_flag",
            "short_alt_text",
            "long_description",
            "structured_description",
            "tables",
            "mathml",
            "latex"
        ]
    },
    "validation_checks": {
        "context_alignment": true,
        "audience_appropriateness": true,
        "no_duplicate_caption_content": true,
        "no_subjective_language": true,
        "domain_compliance": true
    },
    "quality_assurance": {
        "automated_checks": true,
        "human_review_optional": {
            "medical": true,
            "nursing": true,
            "publishing": false,
            "education": false
        },
        "audit_logging": true
    }
}